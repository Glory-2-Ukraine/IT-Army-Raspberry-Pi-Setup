StandardError=journal
Nice=${APP_NICE}
CPUSchedulingPolicy=other
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=${APP_CPU_QUOTA_DAY}
MemoryMax=${APP_MEM_MAX}
TasksMax=512
LimitNOFILE=1000000
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
