# 8. Install Resource Monitor with Time Awareness
# =========================
echo "==> 8) Installing comprehensive resource monitor"
cat <<'MONITOR_SCRIPT' | cat_as_root /usr/local/bin/resource-monitor.sh 0755
#!/usr/bin/env bash
set -euo pipefail

# Configuration
INI_FILE="/opt/itarmy/bin/foobar.ini"
SERVICE_NAME="foobar_proxy_linux"
SERVICE_UNIT="/etc/systemd/system/${SERVICE_NAME}.service.d/90-dynamic-limits.conf"
LOG_FILE="/var/log/foobar/resource-monitor.log"
mkdir -p "/var/log/foobar"
MAX_LOAD=__MAX_LOAD__
MAX_TEMP=__MAX_TEMP__
MAX_NET_LATENCY=__MAX_NET_LATENCY__
IFACE="__SELECTED_IFACE__"
FULL_THROTTLE_START="__FULL_THROTTLE_START__"
FULL_THROTTLE_END="__FULL_THROTTLE_END__"
CPU_MAX_FREQ_DAY=__CPU_MAX_FREQ_DAY__
CPU_MAX_FREQ_NIGHT=__CPU_MAX_FREQ_NIGHT__
CPU_GOVERNOR="__CPU_GOVERNOR__"
USB_AUTOSUSPEND=__USB_AUTOSUSPEND__
DIRTY_WRITEBACK_LOW=__DIRTY_WRITEBACK_LOW__
DIRTY_WRITEBACK_HIGH=__DIRTY_WRITEBACK_HIGH__
MAX_CPU_DAY=__MAX_CPU_DAY__
MAX_CPU_NIGHT=__MAX_CPU_NIGHT__
MAX_MEM=__MAX_MEM__
APP_NICE=__APP_NICE__

# Get current time and determine if it's "night time" (full throttle)
is_night_time() {
    local now=$(date +%H:%M)
    [[ "$now" > "$FULL_THROTTLE_START" ]] || [[ "$now" < "$FULL_THROTTLE_END" ]]
}

# Get system metrics
get_metrics() {
    local load=$(uptime | awk -F'load average: ' '{print $2}' | awk '{print $3}' | cut -d, -f1)
    local cpu
    cpu=$(top -bn1 | awk -F'id,' '/Cpu\\(s\\)/ {gsub(/^[ \t]+|[ \t]+$/, "", $1); split($1,a,","); gsub(/.* /,"",a[length(a)]); print 100 - a[length(a)]}' || true)
    [[ -n "$cpu" ]] || cpu=0
    
    local mem
    mem=$(free | awk '/Mem:/ {printf "%.0f", $3/$2 * 100}' || true)
    [[ -n "$mem" ]] || mem=0

    local temp
    temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{print $1/1000}' || true)
    [[ -n "$temp" ]] || temp=0

    local gw
    gw=$(ip route | awk '/default/ {print $3; exit}' || true)

    local latency=999
    if [[ -n "$gw" ]]; then
        latency=$(ping -c 3 "$gw" 2>/dev/null | tail -1 | awk -F'/' '{print $5}' | cut -d. -f1 || true)
    fi
    [[ -n "$latency" ]] || latency=999
    
    local rx_errors
    local tx_errors
    rx_errors=$(ip -s link show "$IFACE" | awk '/RX:/ {getline; print $3; exit}' || true)
    tx_errors=$(ip -s link show "$IFACE" | awk '/TX:/ {getline; print $3; exit}' || true)
    [[ -n "$rx_errors" ]] || rx_errors=0
    [[ -n "$tx_errors" ]] || tx_errors=0
    
    local retries
    retries=$(iwconfig "$IFACE" 2>/dev/null | grep -c "Retry" || true)
    [[ -n "$retries" ]] || retries=0

    # Get FOOBAR-specific metrics
    local foobar_pid=$(pgrep -f "/opt/itarmy/bin/foobar_proxy_linux" | head -1)
    local foobar_cpu="0"
    local foobar_mem="0"
    local foobar_threads="0"
    if [[ -n "$foobar_pid" ]]; then
        foobar_cpu=$(ps -p $foobar_pid -o %cpu | tail -1)
        foobar_mem=$(ps -p $foobar_pid -o %mem | tail -1)
        foobar_threads=$(ps -p $foobar_pid -o nlwp | tail -1)
    fi

    echo "$load $cpu $mem $temp $latency $tx_errors $rx_errors $retries $foobar_cpu $foobar_mem $foobar_threads"
    echo "$(date -Is) Load=$load, CPU=$cpu%, MEM=$mem%, Temp=${temp}C, Latency=${latency}ms, TX-Err=$tx_errors, RX-Err=$rx_errors, Retries=$retries, FOOBAR-CPU=$foobar_cpu%, FOOBAR-MEM=$foobar_mem%, FOOBAR-Threads=$foobar_threads" >> "$LOG_FILE"
}

# Update systemd limits
update_limits() {
    local cpu_quota=$1
    local mem_max=$2
  
    mkdir -p "$(dirname "$SERVICE_UNIT")"
    {
      echo "[Service]"
      echo "CPUQuota=$cpu_quota"
      echo "MemoryMax=$mem_max"
      echo "Nice=19"
    } > "$SERVICE_UNIT"
    chown root:root "$SERVICE_UNIT"
    chmod 0644 "$SERVICE_UNIT"
    
    systemctl daemon-reload

}

# Adjust settings based on metrics
adjust_settings() {
        read load cpu mem temp latency tx_errors rx_errors retries foobar_cpu foobar_mem foobar_threads <<< "$(get_metrics)"
    local changed=0
    local night_time=$(is_night_time && echo "1" || echo "0")

    # EMERGENCY: If any critical threshold exceeded
    if (( $(echo "$load > $MAX_LOAD" | bc -l) )) || \
       (( $(echo "$temp > $MAX_TEMP" | bc -l) )) || \
       (( $(echo "$latency > $MAX_NET_LATENCY" | bc -l) )); then
        echo "$(date -Is) EMERGENCY: Threshold exceeded. Scaling DOWN!" >> "$LOG_FILE"

        # Reduce to minimum settings
        sed -i "s/threads = .*/threads = 128/" "$INI_FILE"
        sed -i "s/copies = .*/copies = 1/" "$INI_FILE"

        # Set minimum systemd limits
        update_limits "20%" "256M"
        changed=1
    else
        # Time-based settings
        if [[ "$night_time" -eq 1 ]]; then
            # Night time: Full throttle
            max_cpu=$MAX_CPU_NIGHT
            max_threads=4096
            max_mem="$APP_MEM_MAX"
        else
            # Day time: Conservative
            max_cpu=$MAX_CPU_DAY
            max_threads=2048
            max_mem="512M"
        fi

        # Power optimization based on current load
        if (( $(echo "$load < 2.0" | bc -l) )) && [[ "$night_time" -eq 0 ]]; then
            echo "$(date -Is) Low load detected. Applying power savings..." >> "$LOG_FILE"
        
            # Apply daytime CPU frequency limit
            for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
                [[ -w "$f" ]] && echo "$CPU_GOVERNOR" > "$f"
            done
            
            for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
                [[ -w "$f" ]] && echo "$CPU_MAX_FREQ_DAY" > "$f"
            done        
            # Enable USB auto-suspend for non-critical devices
            if [[ "$USB_AUTOSUSPEND" -eq 1 ]]; then
                for usb in /sys/bus/usb/devices/*; do
                    [[ -w "$usb/power/control" ]] || continue
                    echo "auto" > "$usb/power/control"
                done
            fi
        
            # Reduce filesystem sync frequency
            sysctl -w vm.dirty_writeback_centisecs=$DIRTY_WRITEBACK_LOW >/dev/null 2>&1
        elif (( $(echo "$load > $MAX_LOAD" | bc -l) )) || [[ "$night_time" -eq 1 ]]; then
            echo "$(date -Is) High load or night time. Maximizing performance..." >> "$LOG_FILE"
        
            # Restore full CPU frequency
            for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
                [[ -w "$f" ]] && echo "$CPU_MAX_FREQ_NIGHT" > "$f"
            done

            # Disable USB auto-suspend for all devices
            if [[ "$USB_AUTOSUSPEND" -eq 1 ]]; then
                for usb in /sys/bus/usb/devices/*; do
                    [[ -w "$usb/power/control" ]] || continue
                    [[ -e "$usb/net/$IFACE" ]] && continue
                    echo "on" > "$usb/power/control"
                done
            fi
        
            # Increase filesystem performance
            sysctl -w vm.dirty_writeback_centisecs=$DIRTY_WRITEBACK_HIGH >/dev/null 2>&1
        fi

        # Scale based on current usage
        if (( $(echo "$cpu > $max_cpu" | bc -l) )) || (( $(echo "$mem > $MAX_MEM" | bc -l) )); then
            echo "$(date -Is) High resource usage. Scaling DOWN..." >> "$LOG_FILE"

            # Reduce threads
            local threads=$(grep "threads =" "$INI_FILE" | awk '{print $3}')
            if [[ $threads -gt 512 ]]; then
                threads=$((threads - 512))
            else
                threads=128
            fi
            sed -i "s/threads = .*/threads = $threads/" "$INI_FILE"
            changed=1

            # Reduce systemd CPU quota
            local current_quota
            current_quota=$(grep "CPUQuota=" "$SERVICE_UNIT" 2>/dev/null | awk -F= '{print $2}' | tr -d '%' || true)
            [[ -n "$current_quota" ]] || current_quota=40
            if [[ -n "$current_quota" ]] && [[ $current_quota -gt 20 ]]; then
                new_quota=$((current_quota - 10))
                update_limits "${new_quota}%" "$max_mem"
                changed=1
            fi
        elif (( $(echo "$cpu < $((max_cpu-20))" | bc -l) )) && \
             (( $(echo "$mem < 70" | bc -l) )) && \
             (( $(echo "$load < 2.0" | bc -l) )); then
            echo "$(date -Is) Low resource usage. Scaling UP..." >> "$LOG_FILE"

            # Increase threads
            local threads=$(grep "threads =" "$INI_FILE" | awk '{print $3}')
            if [[ $threads -lt $max_threads ]]; then
                threads=$((threads + 256))
                sed -i "s/threads = .*/threads = $threads/" "$INI_FILE"
                changed=1
            fi

            # Increase systemd CPU quota
            local current_quota
            current_quota=$(grep "CPUQuota=" "$SERVICE_UNIT" 2>/dev/null | awk -F= '{print $2}' | tr -d '%' || true)
            [[ -n "$current_quota" ]] || current_quota=40
            if [[ -n "$current_quota" ]] && [[ $current_quota -lt $((max_cpu-10)) ]]; then
                new_quota=$((current_quota + 10))
                update_limits "${new_quota}%" "$max_mem"
                changed=1
            fi
        fi
    fi

    if [[ "$changed" -eq 1 ]]; then
        return 0
    else
        return 1
    fi
}

# Main monitoring loop
main() {
    if adjust_settings; then
        echo "$(date -Is) Restarting $SERVICE_NAME..." >> "$LOG_FILE"
        systemctl restart "$SERVICE_NAME"
    fi
}

main
