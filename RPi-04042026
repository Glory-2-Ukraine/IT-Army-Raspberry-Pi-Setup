need_root

mkdir -p /var/log/foobar
touch /var/log/foobar/setup.log
chown -R root:root /var/log/foobar
chmod -R 755 /var/log/foobar

# For debugging
exec > >(tee -a /var/log/foobar/setup.log) 2>&1
set -x
