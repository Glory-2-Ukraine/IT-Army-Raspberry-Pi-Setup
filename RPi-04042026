#!/usr/bin/env bash
set -euo pipefail

IFACE="__SELECTED_IFACE__"

# Check if FOOBAR is running
# Remove the `if` condition and always run:
echo "$(date -Is) Checking FOOBAR status..." >> /var/log/foobar/crash-protection.log
if ! systemctl is-active --quiet foobar_proxy_linux; then
    echo "$(date -Is) FOOBAR crashed. Restarting..." >> /var/log/foobar/crash-protection.log
    systemctl restart foobar_proxy_linux
    sleep 2
    if ! systemctl is-active --quiet foobar_proxy_linux; then
        echo "Failed to restart FOOBAR service"
    fi

    # Reset power optimizations after crash
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [[ -w "$f" ]] && echo "1400000" > "$f"
    done

    for usb in /sys/bus/usb/devices/*; do
        [[ -w "$usb/power/control" ]] || continue
        echo "on" > "$usb/power/control"
    done
    sysctl -w vm.dirty_writeback_centisecs=500 >/dev/null 2>&1
    echo "$(date -Is) Reset power optimizations after crash" >> /var/log/foobar/crash-protection.log
fi

if journalctl -u foobar_proxy_linux --no-pager -n 50 2>/dev/null | grep -q "Restarting too often"; then
