    sed -i "s/threads = .*/threads = 128/" /opt/itarmy/bin/foobar.ini
    sed -i "s/copies = .*/copies = 1/" /opt/itarmy/bin/foobar.ini
    systemctl restart foobar_proxy_linux
    sleep 2
    if ! systemctl is-active --quiet foobar_proxy_linux; then
        echo "Failed to restart FOOBAR service"
    fi

fi

